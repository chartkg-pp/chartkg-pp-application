{
  "name": "chartkg-pp-application",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite",
    "sync:graphrag": "node scripts/sync-graphrag-data.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "validate:data": "node scripts/validate-static-data.mjs",
    "build": "npm run sync:graphrag && npm run validate:data && npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "dompurify": "^3.4.15",
    "echarts": "^6.1.0",
    "marked": "^18.0.13",
    "pinia": "^2.3.1",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0"
  }
}
